{# Cloudflare 307-redirects any path not in per-segment encodeURIComponent form
   (e.g. Apple+Watch to Apple%2BWatch) before serving it; without these rewrites
   every tag URL containing + stops serving at its Squarespace URL. #}
{%- for item in collections.all %}
{%- set path = item.url | canonical %}
{%- if path and path != (path | encodePathSegments) %}
{{ path }} {{ path | encodePathSegments }} 200
{%- endif %}
{%- endfor %}
{%- for path in collections.tagPageUrls %}
{%- if path != (path | encodePathSegments) %}
{{ path }} {{ path | encodePathSegments }} 200
{%- endif %}
{%- endfor %}
