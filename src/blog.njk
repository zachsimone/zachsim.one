---
layout: layouts/base.njk
title: Blog
permalink: /blog.html
---
<h1>Blog</h1>
{%- set currentYear = 0 %}
{%- for post in collections.posts %}
    {%- set postYear = post.date | postYearSydney %}
    {%- if postYear != currentYear %}
        {%- if currentYear != 0 %}</ul>{% endif %}
        {%- set currentYear = postYear %}
        <h2 class="archive-year">{{ postYear }}</h2>
        <ul class="archive-list">
    {%- endif %}
    <li>
        <time datetime="{{ post.date | w3cDate }}">{{ post.date | readableDate }}</time>
        <a href="{{ post.url | canonical }}">{{ post | listTitle }}</a>
    </li>
{%- endfor %}
</ul>
