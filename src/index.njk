</div>
<div class="recent-posts">
    <h2>Recent posts</h2>
    <ul class="archive-list">
        {%- for post in collections.posts | head(8) %}
        <li>
            <time datetime="{{ post.date | w3cDate }}">{{ post.date | readableDate }}</time>
            <a href="{{ post.url | canonical }}">{{ post.data.title }}</a>
        </li>
        {%- endfor %}
    </ul>
    <p><a href="/blog">All posts →</a></p>
</div>
