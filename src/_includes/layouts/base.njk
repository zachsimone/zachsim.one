<!DOCTYPE html>
<html lang="en-AU">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {%- set pageTitle = title + " — " + site.title if title and page.url != "/" else site.title %}
    <title>{{ pageTitle }}</title>
    {%- set metaDescription = description or site.description %}
    <meta name="description" content="{{ metaDescription }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url | canonical }}">
    <link rel="icon" href="/favicon.ico">
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }} — Blog" href="{{ site.url }}/blog/rss.xml">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ metaDescription }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url | canonical }}">
    <meta property="og:type" content="{{ "article" if isPost else "website" }}">
    {%- if image %}
    <meta property="og:image" content="{{ site.url }}{{ image }}">
    <meta name="twitter:card" content="summary_large_image">
    {%- else %}
    <meta name="twitter:card" content="summary">
    {%- endif %}
    {%- if isPost %}
    <meta property="article:published_time" content="{{ page.date | isoDate }}">
    <meta property="article:author" content="{{ site.author }}">
    {%- endif %}
</head>
<body>
    <header class="site-header">
        <a class="site-title" href="/">{{ site.title }}</a>
        <nav>
            <a href="/blog">Blog</a>
            <a href="/projects">Projects</a>
            <a href="/talks">Talks</a>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
        </nav>
    </header>
    <main>
        {{ content | safe }}
    </main>
    <footer class="site-footer">
        <p>© {% year %} {{ site.author }} · <a href="/blog/rss.xml">RSS</a></p>
    </footer>
</body>
</html>
